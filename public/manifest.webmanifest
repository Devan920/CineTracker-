{
  "id": "/",
  "name": "CineTracker",
  "short_name": "CineTracker",
  "description": "Your personal box-office desk. Collection reports, daily trends and saved movies.",
  "lang": "en-IN",
  "start_url": "/?source=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0f1713",
  "theme_color": "#174f3b",
  "categories": ["entertainment", "news"],
  "prefer_related_applications": false,
  "icons": [
    {"src":"/icons/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},
    {"src":"/icons/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},
    {"src":"/icons/maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}
  ],
  "shortcuts": [
    {"name":"Collection reports","short_name":"Overview","url":"/?view=overview","icons":[{"src":"/icons/icon-192.png","sizes":"192x192"}]},
    {"name":"My watchlist","short_name":"Watchlist","url":"/?view=saved","icons":[{"src":"/icons/icon-192.png","sizes":"192x192"}]}
  ]
}
