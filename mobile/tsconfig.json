{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "node",
      "react",
      "react-dom"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "lucide-react": [
        "node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../app/page.tsx",
    "../lib/platform.ts"
  ]
}
